{
  "name": "mudrix",
  "version": "26.10.16",
  "type": "module",
  "description": "Simple, Secure, Muddy",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node --max-old-space-size=8192 node_modules/vite/bin/vite.js",
    "build": "tsc && vite build",
    "prebuild": "node scripts/build-element-call.mjs",
    "build:element-call": "node scripts/build-element-call.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "commit": "cz"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kapsikkum/mudrix-web"
  },
  "author": "Arian Farahani, Jan Philipp Kleinschmidt",
  "license": "AGPL-3.0",
  "homepage": "https://kapsikkum.github.io/mudrix-web/",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@element-hq/element-call-embedded": "^0.23.0",
    "@floating-ui/dom": "^1.7.6",
    "@fontsource/roboto": "^5.2.10",
    "@matrix-org/matrix-sdk-crypto-wasm": "^18.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.100.1",
    "@tanstack/react-virtual": "^3.14.5",
    "@tauri-apps/api": "2.12.4",
    "@vanilla-extract/css": "^1.20.1",
    "dompurify": "^3.4.1",
    "emojibase-data": "^17.0.0",
    "focus-trap-react": "^12.0.3",
    "i18next": "^26.0.0",
    "jotai": "^2.19.1",
    "marked": "^18.0.2",
    "matrix-encrypt-attachment": "^1.0.3",
    "matrix-js-sdk": "^41.8.0",
    "matrix-widget-api": "^1.17.0",
    "opus-recorder": "^8.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.0",
    "react-router-dom": "^7.18.4",
    "slate": "^0.126.0",
    "slate-history": "^0.113.1",
    "slate-react": "^0.126.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^4.7.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-static-copy": "^2.3.2",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ],
    "*.html": [
      "prettier --write"
    ]
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
